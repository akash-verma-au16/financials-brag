# Copy to .env.local (git-ignored) for local development. See SETUP.md for creating the client ID.
# Used by both `npm run dev` and the always-on server (npm run serve).
# Note: an OAuth *client ID* is public by design (it ships in the page). Never put the client SECRET anywhere.
VITE_GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to use the app. Others are signed out right after sign-in.
# Required: the server refuses every data request from anyone else.
VITE_ALLOWED_EMAILS=

